{
  "schema_version": 1,
  "analysis_plan_version": 1,
  "analysis_plan_id": "formal-study-v1-analysis-v1",
  "matrix_id": "formal-study-v1-matrix-v1",
  "status": "preregistered_draft_pending_phase_09_precision_values",
  "analysis_units": {
    "independent_inference_unit": "run",
    "request_level_role": "nested_descriptive_only",
    "request_grouping_keys": ["campaign_id", "cell_id", "repeat_index", "run_id"],
    "broadcast_logical_group_keys": ["run_id", "scenario_id", "logical_request_id"],
    "no_request_level_pseudoreplication": true
  },
  "required_summaries": ["count", "mean", "median", "sd", "iqr", "min", "max", "p50", "p95", "ci95", "coefficient_of_variation", "failure_rate"],
  "primary_outcomes": [
    {"metric": "cluster_tokens_per_s", "unit": "generated tokens/s", "level": "run", "direction": "higher_is_better"},
    {"metric": "requests_per_s", "unit": "successful requests/s", "level": "run", "direction": "higher_is_better"},
    {"metric": "ttft_s", "unit": "seconds", "level": "request_nested_in_run", "direction": "lower_is_better"},
    {"metric": "e2e_s", "unit": "seconds", "level": "request_nested_in_run", "direction": "lower_is_better"},
    {"metric": "success_rate", "unit": "proportion", "level": "run", "direction": "higher_is_better"}
  ],
  "strategy_specific_outcomes": {
    "replicated_round_robin": ["cluster_tokens_per_s", "requests_per_s", "speedup_vs_pi_02_single", "scaling_efficiency"],
    "broadcast_compare": ["all_replicas_success_rate", "answer_agreement_rate", "per_node_ttft", "per_node_e2e"],
    "single_node": ["cluster_tokens_per_s", "requests_per_s", "ttft_s", "e2e_s"]
  },
  "confidence_intervals": {
    "level": 0.95,
    "method": "percentile_bootstrap",
    "bootstrap_resamples": 10000,
    "resampling_unit": "run",
    "seed": 20260823,
    "stratify_by": ["cell_id"],
    "pilot_precision_target": "to_be_frozen_in_phase_09_before_formal_execution"
  },
  "primary_contrasts": [
    {
      "contrast_id": "jetson-vs-pi-single-node",
      "scope": "descriptive_between_locked_runtime_cohorts",
      "match_on": ["model_lock_key", "prompt_id", "strategy", "node_count"],
      "warning": "hardware, backend, OS, and runtime differ; do not claim a pure platform causal effect"
    },
    {
      "contrast_id": "pi-node-count-scaling",
      "scope": "primary",
      "baseline": "pi-worker-02 single_node",
      "comparators": ["pi-02-03 replicated_round_robin", "pi-02-03-04 replicated_round_robin"],
      "match_on": ["model_lock_key", "prompt_id", "repeat_index"]
    },
    {
      "contrast_id": "pi-broadcast-agreement",
      "scope": "primary_strategy_specific",
      "match_on": ["model_lock_key", "prompt_id"],
      "note": "physical replica throughput is not user-visible logical throughput"
    },
    {
      "contrast_id": "jetson-maxn-vs-15w",
      "scope": "exploratory_descriptive",
      "match_on": ["model_lock_key", "prompt_id", "L4T", "kernel"],
      "warning": "different physical Workers; not a randomized within-Worker power effect"
    }
  ],
  "multiple_comparisons": {
    "family_definition": "outcome by declared primary contrast",
    "adjustment": "Holm",
    "unadjusted_effect_sizes_and_ci_always_reported": true
  },
  "distribution_outputs": {
    "latency": ["ECDF", "box_plot", "median_and_iqr", "p50", "p95"],
    "throughput": ["run_level_dot_and_interval", "box_plot"],
    "scaling": ["node_count_curve", "speedup_curve", "efficiency_curve"],
    "broadcast": ["agreement_rate", "all_replicas_success_rate", "per_node_latency"]
  },
  "measurement_quality": {
    "primary": {
      "jetson": ["clean"],
      "raspberry_pi": ["clean", "warning"]
    },
    "sensitivity": {
      "jetson": ["clean", "warning"],
      "raspberry_pi": ["clean"]
    },
    "exclude_from_estimates": ["degraded", "unknown"],
    "retain_and_count_excluded_runs": true,
    "pi_history_warning_is_nonblocking": true
  },
  "failure_and_exclusion": {
    "preserve_raw": true,
    "imputation": "none",
    "failed_request_latency": "exclude_from_success_latency_distribution",
    "failed_request_role": "include_in_failure_rate",
    "whole_run_exclusion_codes": [
      "MODEL_SHA_MISMATCH",
      "SOURCE_FINGERPRINT_MISMATCH",
      "RUNTIME_LOCK_MISMATCH",
      "RUNTIME_COHORT_MISMATCH",
      "JETSON_POWER_MODE_MISMATCH",
      "PROMPT_SET_MISMATCH",
      "CONDITION_PROFILE_MISMATCH",
      "ACTIVE_POWER_INTEGRITY_FAULT",
      "THERMAL_STABILIZATION_VIOLATION",
      "INSTRUMENTATION_FAILURE",
      "CLEANUP_FAILED"
    ],
    "outlier_rule": "no automatic removal; report robust summaries and investigate only by predefined exclusion codes",
    "retry_rule": "a retry is a distinct attempt and never overwrites the failed attempt"
  },
  "experiment_type_separation": {
    "pooling_allowed": false,
    "pilot_in_formal_estimates": false,
    "smoke_in_formal_estimates": false,
    "separate_campaign_ids_and_output_directories": true
  },
  "interpretation_limits": [
    "The approved 1.5B Qwen and 2B Granite models do not identify a pure model-size effect because family changes too.",
    "Jetson power-mode comparisons are descriptive until a randomized within-Worker crossover is locked.",
    "No heterogeneous or RPC formal estimate is produced by matrix v1.",
    "Broadcast aggregate physical throughput is not equivalent to logical user throughput."
  ]
}
