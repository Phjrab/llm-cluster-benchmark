{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://llm-cluster-benchmark.local/schemas/measurement-artifact-v3.json",
  "title": "LLM Cluster additive measurement record",
  "type": "object",
  "required": ["schema_version", "record_type", "sampled_at", "run_id", "scenario_id", "node"],
  "properties": {
    "schema_version": {"enum": [1, 2, 3]},
    "record_type": {"enum": ["request_metrics", "telemetry_sample", "rpc_lifecycle"]},
    "sampled_at": {"type": "string", "format": "date-time"},
    "run_id": {"type": "string", "minLength": 1},
    "scenario_id": {"type": ["string", "null"]},
    "node": {"type": ["string", "null"]},
    "request_id": {"type": ["integer", "null"]},
    "logical_request_id": {"type": ["integer", "null"]},
    "sample_kind": {"enum": ["idle", "measurement"]},
    "monotonic_elapsed_s": {"type": ["number", "null"]},
    "collection_overhead_s": {"type": ["number", "null"], "minimum": 0},
    "input_tokens": {"type": ["integer", "null"], "minimum": 0},
    "prefill_time_s": {"type": ["number", "null"], "minimum": 0},
    "prefill_tokens_per_s": {"type": ["number", "null"], "minimum": 0},
    "decode_time_s": {"type": ["number", "null"], "minimum": 0},
    "decode_tokens_per_s": {"type": ["number", "null"], "minimum": 0},
    "total_tokens": {"type": ["integer", "null"], "minimum": 0},
    "generated_tokens": {"type": ["integer", "null"], "minimum": 0},
    "token_count_source": {"enum": ["server_usage", "llama_cpp_tokenize", "retokenized_output", "stream_chunk_estimate", "unavailable"]},
    "inference_path": {"type": ["string", "null"]},
    "fallback_reason_code": {"type": ["string", "null"]},
    "chat_template_hash": {"type": ["string", "null"]},
    "template_hash": {"type": ["string", "null"]},
    "controller_executor_queue_wait_s": {"type": ["number", "null"], "minimum": 0},
    "worker_inference_lock_wait_s": {"type": ["number", "null"], "minimum": 0},
    "prompt_eval_s": {"type": ["number", "null"], "minimum": 0},
    "inference_slots": {"type": ["integer", "null"], "minimum": 1},
    "power_w": {"type": ["number", "null"]},
    "power_provider": {"type": ["string", "null"]},
    "telemetry_provider": {"type": ["string", "null"]},
    "telemetry_degraded": {"type": "boolean"},
    "telemetry_error": {"type": "string"},
    "power_mode": {"type": ["string", "integer", "null"]},
    "jetson_clocks": {"type": ["boolean", "string", "null"]},
    "temperatures_c": {"type": "object", "additionalProperties": {"type": ["number", "null"]}},
    "cpu_frequency_mhz": {"type": ["number", "null"]},
    "throttled": {"type": ["boolean", "null"]},
    "rtt_s": {"type": ["number", "null"], "minimum": 0},
    "connection_setup_s": {"type": ["number", "null"], "minimum": 0},
    "bytes_sent": {"type": ["integer", "null"], "minimum": 0},
    "bytes_received": {"type": ["integer", "null"], "minimum": 0},
    "effective_bandwidth_bytes_s": {"type": ["number", "null"], "minimum": 0},
    "coordinator_wait_s": {"type": ["number", "null"], "minimum": 0},
    "availability": {"type": "object"}
  },
  "additionalProperties": true
}
