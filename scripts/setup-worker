#!/usr/bin/env bash
# Delegate worker-only inference setup to the existing Linux worker installer.
set -euo pipefail

SCRIPT_DIR="$(cd -P "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd -P "$SCRIPT_DIR/.." && pwd)"

if [[ $# -ne 0 ]]; then
  echo "Usage: ./scripts/setup-worker" >&2
  exit 64
fi

if [[ "$(uname -s)" != "Linux" ]]; then
  echo "[ERROR] setup-worker is for Jetson/Raspberry Pi Linux workers only. The macOS Controller must use ./scripts/setup-controller." >&2
  exit 1
fi

exec "$PROJECT_ROOT/cluster/worker_setup.sh" --install --project-dir "$PROJECT_ROOT"
