#!/usr/bin/env python3
"""Resolve this checkout, then execute the Controller lifecycle command.

This intentionally contains no lifecycle logic. Keeping it as a Python
entrypoint makes a user-level symbolic link safe: ``Path(__file__).resolve()``
always finds the checked-out repository rather than the directory from which
the command was invoked.
"""

from __future__ import annotations

import os
import sys
from pathlib import Path


PROJECT_ROOT = Path(__file__).resolve().parent.parent
PYTHON_BIN = PROJECT_ROOT / ".venv" / "bin" / "python"


def main(argv: list[str]) -> int:
    if len(argv) != 2 or argv[1] not in {"start", "stop", "restart", "status", "logs"}:
        print("Usage: llm-cluster start|stop|restart|status|logs", file=sys.stderr)
        return 64
    if not PYTHON_BIN.is_file() or not os.access(PYTHON_BIN, os.X_OK):
        print(
            f"[llm-cluster-benchmark] Controller virtual environment is missing: {PYTHON_BIN}\n"
            "Run ./scripts/setup-controller from the repository first.",
            file=sys.stderr,
        )
        return 1
    environment = dict(os.environ)
    existing_path = environment.get("PYTHONPATH", "")
    environment["PYTHONPATH"] = (
        f"{PROJECT_ROOT}{os.pathsep}{existing_path}" if existing_path else str(PROJECT_ROOT)
    )
    os.execve(
        str(PYTHON_BIN),
        [str(PYTHON_BIN), "-m", "cluster.cli.controller", *argv[1:]],
        environment,
    )
    return 1


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
